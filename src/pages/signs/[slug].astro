---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Category, SignEntry } from "../../lib/types";
import signsData from "../../data/signs.json";
import categoriesData from "../../data/categories.json";

const signs = signsData as SignEntry[];
const categories = categoriesData as Category[];
const bySlug = new Map(signs.map((s) => [s.slug, s]));

export async function getStaticPaths() {
  const all = signsData as SignEntry[];
  return all.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: SignEntry };
const related = entry.related
  .map((slug) => bySlug.get(slug))
  .filter((s): s is SignEntry => Boolean(s));
const category = categories.find((c) => c.slug === entry.category);
const pageUrl = new URL(`/signs/${entry.slug}/`, Astro.site).toString();
const dictionaryUrl = new URL("/dictionary/", Astro.site).toString();

const definedTerm = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: `${entry.word} in American Sign Language`,
  description: entry.steps.join(" "),
  inDefinedTermSet: {
    "@type": "DefinedTermSet",
    name: "ASL Signs Dictionary",
    url: dictionaryUrl,
  },
  url: pageUrl,
};

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: Astro.site?.toString() },
    { "@type": "ListItem", position: 2, name: "Dictionary", item: dictionaryUrl },
    { "@type": "ListItem", position: 3, name: entry.word, item: pageUrl },
  ],
};
---

<BaseLayout
  title={`How to sign "${entry.word}" in ASL | Sign Language Translator`}
  description={`Learn to sign "${entry.word}" in American Sign Language: step-by-step instructions with a practice tip.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(definedTerm)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />

  <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
        <li><a class="underline-offset-2 hover:underline" href="/">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a class="underline-offset-2 hover:underline" href="/dictionary/">Dictionary</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-semibold text-slate-900">{entry.word}</li>
      </ol>
    </nav>

    <h1 class="mt-6 text-4xl font-extrabold text-slate-900">
      How to sign <span class="text-indigo-700">“{entry.word}”</span> in ASL
    </h1>
    {category && (
      <p class="mt-3">
        <a
          href="/dictionary/"
          class="inline-block rounded-full bg-indigo-100 px-4 py-1 text-sm font-semibold text-indigo-800 hover:bg-indigo-200"
        >
          {category.name}
        </a>
      </p>
    )}

    <section aria-labelledby="steps-heading" class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
      <h2 id="steps-heading" class="text-2xl font-bold text-slate-900">Step by step</h2>
      <ol class="mt-4 list-decimal space-y-3 pl-6 text-lg text-slate-800">
        {entry.steps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      {entry.tip && (
        <div class="mt-6 rounded-xl border-l-4 border-amber-500 bg-amber-50 px-4 py-3">
          <p class="font-semibold text-slate-900">Practice tip</p>
          <p class="mt-1 text-slate-800">{entry.tip}</p>
        </div>
      )}
    </section>

    <div
      role="note"
      class="mt-6 rounded-xl border border-slate-200 bg-slate-50 px-5 py-4 text-slate-700"
    >
      <p class="text-sm">
        Text-based guide researched from established ASL references (Lifeprint,
        university and public-health materials) and rewritten in original words.
        Signer-created photos and videos are a planned future upgrade.
      </p>
    </div>

    {related.length > 0 && (
      <section aria-labelledby="related-heading" class="mt-10">
        <h2 id="related-heading" class="text-2xl font-bold text-slate-900">Related signs</h2>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2">
          {related.map((r) => (
            <li>
              <a
                href={`/signs/${r.slug}/`}
                class="block rounded-xl border border-slate-200 bg-white p-5 hover:border-indigo-700"
              >
                <p class="text-lg font-bold text-slate-900">{r.word}</p>
                <p class="mt-1 line-clamp-2 text-sm text-slate-600">{r.steps[0]}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="mt-10 text-center">
      <a href="/dictionary/" class="font-semibold text-indigo-700 underline underline-offset-2">
        Browse all {signs.length} signs in the dictionary
      </a>
    </p>
  </div>
</BaseLayout>
