---
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = [
  {
    slug: "i-miss-you-in-sign-language",
    title: "I Miss You in Sign Language: How to Sign It in ASL & BSL",
    description:
      "Learn to sign \u2018I miss you\u2019 in American Sign Language: the I-MISS-YOU construction step by step, what to do in BSL, and common mistakes to avoid.",
    datePublished: "2026-10-06",
  },
];
---

<BaseLayout
  title="Blog | Sign Language Translator"
  description="Blog posts from SignLanguage-Translator.com: how to sign common phrases in ASL and BSL, step by step."
>
  <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
    <nav aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-sm text-slate-500">
        <li><a class="underline-offset-2 hover:underline" href="/">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-semibold text-slate-900">Blog</li>
      </ol>
    </nav>

    <h1 class="mt-6 text-4xl font-extrabold text-slate-900">Blog</h1>
    <p class="mt-4 max-w-3xl text-lg text-slate-600">
      How to sign common phrases in ASL and BSL &mdash; researched step by
      step. For structured daily lessons, see{" "}
      <a class="font-semibold text-indigo-700 underline" href="/learn/">Learn sign language</a>.
    </p>

    <ul class="mt-10 space-y-6">
      {posts.map((p) => (
        <li>
          <a
            href={`/blog/${p.slug}/`}
            class="block rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-indigo-700 hover:shadow-sm"
          >
            <p class="text-sm font-medium text-slate-500">
              <time datetime={p.datePublished}>{p.datePublished}</time>
            </p>
            <h2 class="mt-1 text-2xl font-bold text-slate-900">{p.title}</h2>
            <p class="mt-2 text-slate-600">{p.description}</p>
            <p class="mt-3 font-semibold text-indigo-700">Read article &rarr;</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
