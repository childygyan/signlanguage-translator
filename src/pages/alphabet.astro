---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { AlphabetEntry, NumberEntry } from "../lib/types";
import alphabetData from "../data/alphabet.json";
import numbersData from "../data/numbers.json";

const letters = alphabetData as AlphabetEntry[];
const numbers = numbersData as NumberEntry[];
---

<BaseLayout
  title="ASL Alphabet & Numbers | Sign Language Translator"
  description="The complete ASL fingerspelling reference: A–Z handshapes with motion notes, plus numbers 0–10."
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <h1 class="text-4xl font-extrabold text-slate-900">ASL Alphabet &amp; Numbers</h1>
    <p class="mt-4 max-w-3xl text-lg text-slate-600">
      The fingerspelling reference every ASL learner starts with. Letters marked
      as <strong>motion letters</strong> are signed with movement, not a static
      handshape.
    </p>

    <h2 class="mt-12 text-2xl font-bold text-slate-900">Letters A–Z</h2>
    <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {letters.map((l) => (
        <li
          class={`rounded-2xl border p-5 ${l.motion ? "border-amber-400 bg-amber-50" : "border-slate-200 bg-white"}`}
        >
          <img
            src={`/alphabet/${l.letter.toLowerCase()}.svg`}
            alt={`ASL handshape for the letter ${l.letter}`}
            class="mx-auto h-40 w-auto"
            loading="lazy"
          />
          <div class="mt-3 flex items-center justify-between">
            <span class="text-2xl font-extrabold text-slate-900" aria-label={`Letter ${l.letter}`}>
              {l.letter}
            </span>
            {l.motion && (
              <span class="rounded-full bg-amber-400 px-3 py-1 text-sm font-bold text-slate-900">
                Motion letter
              </span>
            )}
          </div>
          <p class="mt-2 text-slate-700">{l.handshape}</p>
        </li>
      ))}
    </ul>

    <h2 class="mt-12 text-2xl font-bold text-slate-900">Numbers 0–10</h2>
    <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {numbers.map((n) => (
        <li class="rounded-2xl border border-slate-200 bg-white p-5">
          <img
            src={`/numbers/${n.digit}.svg`}
            alt={`ASL handshape for the number ${n.digit}`}
            class="mx-auto h-40 w-auto"
            loading="lazy"
          />
          <span class="mt-3 block text-2xl font-extrabold text-slate-900" aria-label={`Number ${n.digit}`}>
            {n.digit}
          </span>
          <p class="mt-2 text-slate-700">{n.handshape}</p>
        </li>
      ))}
    </ul>

    <div
      role="note"
      class="mt-10 rounded-xl border border-slate-200 bg-slate-50 px-5 py-4 text-slate-700"
    >
      <p class="font-semibold text-slate-900">Practice note</p>
      <p class="mt-1">
        Fingerspelling is for names and terms with no established sign — most
        everyday ASL uses word-level signs. Learn these handshapes, then explore
        the <a class="font-semibold text-indigo-700 underline" href="/dictionary/">sign dictionary</a> for
        real vocabulary.
      </p>
    </div>
  </div>
</BaseLayout>
