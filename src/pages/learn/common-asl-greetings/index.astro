---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const title = "ASL Greetings: 10+ Ways to Say Hello, Goodbye and More";
const description =
  "10+ ASL greetings every beginner should know: hello, goodbye, good morning, good night, how are you, nice to meet you and more — with the signs, when to use each, and common beginner mistakes.";
const datePublished = "2026-10-12";
const slug = "common-asl-greetings";
const pageUrl = `https://signlanguage-translator.com/learn/${slug}/`;

const faqs = [
  {
    q: "How do you say hello in ASL?",
    a: "Sign hello with a salute-like motion at the forehead: raise your dominant hand to your forehead, palm facing outward, fingers together pointing up, then move your hand away from your forehead in a small salute-like motion. The forehead location is what makes it hello — a plain wave at chest height won't read as the sign.",
  },
  {
    q: "How do you say goodbye in ASL?",
    a: "Raise your open hand, palm facing outward, and wave it side to side. Use goodbye when parting at the end of a conversation, not when you're still settling in.",
  },
  {
    q: "How do you say good morning in ASL?",
    a: "Good morning is a compound sign: sign GOOD (touch your chin with flat fingertips, then bring the hand down into your other open palm), then MORNING (rest your dominant fingertips in the crook of your other arm, held across your chest, and lift them upward like a sunrise).",
  },
  {
    q: "How do you sign 'how are you' in ASL?",
    a: "Honestly: our dictionary doesn't include a dedicated HOW-ARE-YOU sign, so don't invent one. Signers commonly fingerspell the question (H-O-W A-R-E Y-O-U) with raised eyebrows — in ASL, eyebrows-up marks a yes/no question — or sign the individual words. Our upcoming 'how are you' guide covers this in detail.",
  },
  {
    q: "How do you sign 'nice to meet you' in ASL?",
    a: "Our dictionary doesn't carry this phrase as a single sign yet. The safe approach is to fingerspell it letter by letter — fingerspelling is always correct when you don't have an established sign.",
  },
  {
    q: "What's the difference between good morning and hello?",
    a: "Use good morning when greeting someone at the start of the day, and hello at any other time. Good night works the same way as a parting sign in the evening — it means you're heading off, not that you're mid-conversation.",
  },
];

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished,
  author: { "@type": "Person", name: "Firoz Khan" },
  publisher: {
    "@type": "Organization",
    name: "SignLanguage-Translator.com",
  },
  mainEntityOfPage: pageUrl,
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout title={`${title} | Sign Language Translator`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
        <li><a class="underline-offset-2 hover:underline" href="/">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a class="underline-offset-2 hover:underline" href="/learn/">Learn</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-semibold text-slate-900">{title}</li>
      </ol>
    </nav>

    <h1 class="mt-6 text-4xl font-extrabold text-slate-900">{title}</h1>
    <p class="mt-3 text-sm text-slate-500">
      <time datetime={datePublished}>{datePublished}</time> · By Firoz Khan · 7 min read
    </p>

    <article class="prose-lg mt-6 space-y-5 text-slate-700">
      <p>
        Here are <strong>11 ASL greetings and everyday polite signs</strong>{" "}
        every beginner should learn first: hello, goodbye, good morning, good
        night, thank you, please, sorry, excuse me, I love you, help, and what
        is your name. Each one links to a step-by-step dictionary guide — learn
        the sign, when to use it, and the mistake to avoid.
      </p>

      <figure class="my-6 text-center">
        <div class="flex items-end justify-center gap-4">
          <img class="h-32 w-auto" loading="lazy" src="/alphabet/h.svg" alt="ASL handshape for the letter H — initial of hello" />
          <img class="h-32 w-auto" loading="lazy" src="/alphabet/g.svg" alt="ASL handshape for the letter G — initial of goodbye" />
          <img class="h-32 w-auto" loading="lazy" src="/alphabet/m.svg" alt="ASL handshape for the letter M — initial of morning" />
          <img class="h-32 w-auto" loading="lazy" src="/alphabet/n.svg" alt="ASL handshape for the letter N — initial of night" />
        </div>
        <figcaption class="mt-2 text-sm text-slate-500">
          ASL alphabet initials of the four core greetings: H (hello), G (goodbye), M (morning), N (night).
        </figcaption>
      </figure>

      <h2 class="pt-4 text-2xl font-bold text-slate-900">The 11 greetings</h2>
      <ol class="list-decimal space-y-4 pl-6">
        <li>
          <a class="font-semibold text-indigo-700 underline" href="/signs/hello/">Hello</a>{" "}
          — a salute-like motion at the forehead: raise your dominant hand to
          your forehead, palm out, fingers together pointing up, then move it
          away in a small salute. Use it any time of day when meeting someone.
        </li>
        <li>
          <a class="font-semibold text-indigo-700 underline" href="/signs/goodbye/">Goodbye</a>{" "}
          — raise your open hand, palm facing out, and wave it side to side.
          Use when parting at the end of a conversation.
        </li>
        <li>
          <a class="font-semibold text-indigo-700 underline" href="/signs/good-morning/">Good morning</a>{" "}
          — a compound: GOOD (flat fingertips touch chin, then drop into your
          other open palm), then MORNING (fingertips in the crook of your other
          arm, held across your chest, lifted upward like a sunrise). Use when
          greeting someone at the start of the day.
        </li>
        <li>
          <a class="font-semibold text-indigo-700 underline" href="/signs/good-night/">Good night</a>{" "}
          — GOOD, then NIGHT: rest your dominant fingertips in the crook of
          your other arm and move your hand downward over the arm, like the sun
          setting. Use when parting in the evening.
        </li>
        <li>
          <a class="font-semibold text-indigo-700 underline" href="/signs/thank-you/">Thank you</a>{" "}
          — touch your chin with the fingertips of your flat hand, palm facing
          you, then move your hand forward and slightly down. Use it as often
          as you would say thanks in English.
        </li>
        <li>
          <a class="font-semibold text-indigo-700 underline" href="/signs/please/">Please</a>{" "}
          — place your flat dominant hand on your chest, palm down, and rub it
          in a small clockwise circle. Add it to requests the way you'd say
          "please" in speech.
        </li>
        <li>
          <a class="font-semibold text-indigo-700 underline" href="/signs/sorry/">Sorry</a>{" "}
          — make a loose fist, palm facing your chest, and rub it in small
          circles over your heart. Match your face to the apology.
        </li>
        <li>
          <a class="font-semibold text-indigo-700 underline" href="/signs/excuse-me/">Excuse me</a>{" "}
          — hold your open hand at your chest, fingers together, and brush your
          fingertips upward against your chest twice. Use it to get attention
          politely or to pass by someone.
        </li>
        <li>
          <a class="font-semibold text-indigo-700 underline" href="/signs/i-love-you/">I love you</a>{" "}
          — raise your thumb, index finger, and pinky together, curl the other
          fingers, and hold the hand up. A warm greeting for friends and family
          — not for strangers.
        </li>
        <li>
          <a class="font-semibold text-indigo-700 underline" href="/signs/help/">Help</a>{" "}
          — make a fist with your dominant hand, rest it on your other open
          palm, and lift both hands upward together. The sign to know before
          you need it.
        </li>
        <li>
          <a class="font-semibold text-indigo-700 underline" href="/signs/what-is-your-name/">What is your name</a>{" "}
          — WHAT (a palms-up shrug), point an open palm toward the person
          (YOUR), then NAME (tap your index and middle fingers across the same
          two fingers of your other hand). The standard way to ask someone's name.
        </li>
      </ol>

      <h2 class="pt-4 text-2xl font-bold text-slate-900">What about "how are you"?</h2>
      <p>
        This one deserves honesty, not a fake sign. Our dictionary does not
        include a dedicated HOW-ARE-YOU sign, and inventing one would teach you
        wrong. In real conversation, signers commonly <strong>fingerspell the
        question — H-O-W A-R-E Y-O-U</strong> — with raised eyebrows (in ASL,
        eyebrows-up marks a yes/no question), or sign the individual words and
        let context carry the rest. Fingerspelling it is never wrong. A
        dedicated guide to "how are you" plus more everyday phrases is coming
        later in this series.
      </p>

      <h2 class="pt-4 text-2xl font-bold text-slate-900">Common beginner mistakes</h2>
      <ul class="list-disc space-y-2 pl-6">
        <li>
          <strong>Signing hello at the wrong location.</strong> The forehead
          placement is what makes it hello. Drifting down to chest level turns
          it into an unrecognizable gesture.
        </li>
        <li>
          <strong>Using good night as a hello.</strong> Good night is a parting
          sign for the evening — signing it on arrival reads like you're
          leaving immediately.
        </li>
        <li>
          <strong>Fingerspelling greetings.</strong> H-E-L-L-O letter by letter
          is slow and unnatural when a word-level sign exists. Save
          fingerspelling for names — learn the greeting signs.
        </li>
        <li>
          <strong>Forgetting your face.</strong> A greeting signed with a flat
          expression can come across as abrupt. Match your face to your intent,
          and keep eye contact during introductions.
        </li>
      </ul>

      <h2 class="pt-4 text-2xl font-bold text-slate-900">Frequently asked questions</h2>
      <dl class="space-y-4">
        {faqs.map((f) => (
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <dt class="font-bold text-slate-900">{f.q}</dt>
            <dd class="mt-2 text-slate-700">{f.a}</dd>
          </div>
        ))}
      </dl>

      <h2 class="pt-4 text-2xl font-bold text-slate-900">Keep learning</h2>
      <ul class="list-disc space-y-2 pl-6">
        <li>
          <a class="font-semibold text-indigo-700 underline" href="/learn/how-to-fingerspell-your-name-in-asl/">How to fingerspell your name in ASL</a>{" "}
          — the letter-by-letter skill behind every introduction.
        </li>
        <li>
          <a class="font-semibold text-indigo-700 underline" href="/learn/essential-asl-signs-for-beginners/">Essential ASL signs for beginners</a>{" "}
          — the next words to learn after greetings.
        </li>
        <li>
          <a class="font-semibold text-indigo-700 underline" href="/dictionary/">ASL signs dictionary</a>{" "}
          — look up every greeting and practice from the step-by-step pages.
        </li>
      </ul>
    </article>

    <div
      role="note"
      class="mt-10 rounded-xl border border-slate-200 bg-slate-50 px-5 py-4 text-sm text-slate-700"
    >
      <p>
        A learning aid, not a certified interpreter. Greeting signs are a
        starting point — real fluency comes from learning with Deaf instructors
        and the Deaf community.
      </p>
    </div>
  </div>
</BaseLayout>
