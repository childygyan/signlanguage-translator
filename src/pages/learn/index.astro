---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ARTICLES } from "./articles";

const sorted = [...ARTICLES].sort((a, b) =>
  b.datePublished.localeCompare(a.datePublished),
);

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Learn Sign Language — articles",
  itemListElement: sorted.map((a, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: `https://signlanguage-translator.com/learn/${a.slug}/`,
    name: a.title,
  })),
};
---

<BaseLayout
  title="Learn Sign Language — ASL & BSL Articles | Sign Language Translator"
  description="Step-by-step learning articles for American Sign Language and British Sign Language: fingerspelling, essential signs, grammar basics and practice tips."
>
  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />

  <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
    <nav aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-sm text-slate-500">
        <li><a class="underline-offset-2 hover:underline" href="/">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-semibold text-slate-900">Learn</li>
      </ol>
    </nav>

    <h1 class="mt-6 text-4xl font-extrabold text-slate-900">Learn Sign Language</h1>
    <p class="mt-4 max-w-3xl text-lg text-slate-600">
      Practical, step-by-step articles for learning American Sign Language (ASL)
      and British Sign Language (BSL) — fingerspelling, essential vocabulary,
      and the honest basics nobody should skip. New article every day.
    </p>

    <div
      role="note"
      class="mt-6 rounded-xl border-l-4 border-amber-500 bg-amber-50 px-4 py-3 text-slate-800"
    >
      <p class="text-sm">
        A learning aid, not a certified interpreter. Text guides are a starting
        point — real fluency comes from learning with Deaf instructors and the
        Deaf community.
      </p>
    </div>

    {sorted.length === 0 ? (
      <p class="mt-10 rounded-xl border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center text-slate-600">
        The first article publishes soon — check back tomorrow.
      </p>
    ) : (
      <ul class="mt-10 space-y-6">
        {sorted.map((a) => (
          <li>
            <a
              href={`/learn/${a.slug}/`}
              class="block rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-indigo-700 hover:shadow-sm"
            >
              <p class="text-sm font-medium text-slate-500">
                <time datetime={a.datePublished}>{a.datePublished}</time>
              </p>
              <h2 class="mt-1 text-2xl font-bold text-slate-900">{a.title}</h2>
              <p class="mt-2 text-slate-600">{a.description}</p>
              <p class="mt-3 font-semibold text-indigo-700">Read article →</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
