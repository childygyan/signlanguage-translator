---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Sign Language Translator"
  description="Contact the team behind SignLanguage-Translator.com — send us an email."
>
  <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <h1 class="text-4xl font-extrabold text-slate-900">Contact</h1>
    <p class="mt-4 text-lg text-slate-600">
      Questions, corrections to a sign description, or suggestions for new
      dictionary words — we'd like to hear from you. Email is the fastest way
      to reach us.
    </p>

    <div class="mt-8">
      <a
        href="mailto:fkdigitalmedia@gmail.com"
        class="block rounded-2xl border border-slate-200 bg-white p-6 hover:border-indigo-700"
      >
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">Email</p>
        <p class="mt-2 break-all text-xl font-bold text-indigo-700">
          fkdigitalmedia@gmail.com
        </p>
        <p class="mt-2 text-slate-600">We reply to every genuine message.</p>
      </a>
    </div>

    <p class="mt-8 rounded-xl bg-slate-50 px-4 py-3 text-slate-600">
      Please don't share sensitive personal information over email. This site is
      a learning aid — for urgent communication needs involving Deaf or
      hard-of-hearing people, contact a qualified interpreting service directly.
    </p>
  </div>
</BaseLayout>
